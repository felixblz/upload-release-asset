{
  "name": "upload-release-asset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Upload a release asset to an existing GitHub Release",
  "main": "dist/index.js",
  "scripts": {
    "prettier": "npx prettier . --write",
    "prettier:check": "npx prettier . --check",
    "build": "npm run prettier && npm run build:only",
    "build:only": "ncc build src/main.js --license licenses.txt",
    "precommit": "npm run build && git add dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixblz/upload-release-asset"
  },
  "author": "felixblz",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.9"
  }
}
